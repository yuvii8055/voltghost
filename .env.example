# VoltGhost Environment Variables

# Optional: Google Gemini API Key for Carbon Coach AI
# If omitted or invalid, VoltGhost seamlessly activates its realistic, domain-grounded offline Carbon Coach fallback
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional: Default Tariff (INR / kWh)
VITE_DEFAULT_TARIFF_INR=8.50

# Optional: Grid Emission Factor (kg CO2 / kWh)
VITE_DEFAULT_EMISSION_FACTOR=0.71
